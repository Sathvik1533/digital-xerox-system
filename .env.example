# Environment configuration template
# Copy this to .env and fill in your values
# NEVER commit .env to git

# Application
ENVIRONMENT=development
DEBUG=true

# AWS Region
AWS_REGION=ap-south-1

# AWS credentials — for LOCAL DEVELOPMENT only
# In production (ECS), credentials come from the IAM role attached to the task.
# Never put real credentials here in production.
AWS_ACCESS_KEY_ID=your-access-key-id-here
AWS_SECRET_ACCESS_KEY=your-secret-access-key-here

# DynamoDB
DYNAMODB_TABLE_NAME=digital-xerox-orders
# Uncomment for local DynamoDB (docker run -p 8000:8000 amazon/dynamodb-local)
# DYNAMODB_ENDPOINT_URL=http://localhost:8000

# S3
S3_BUCKET_NAME=digital-xerox-documents
# Uncomment for local S3 mock (moto server)
# S3_ENDPOINT_URL=http://localhost:5000

# Pricing (in paise — smallest unit)
PRICE_PER_PAGE_BW=100
PRICE_PER_PAGE_COLOR=500
