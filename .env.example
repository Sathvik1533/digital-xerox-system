# ==============================================================================
# Environment Configuration Template
# Digital Xerox & Stationery Ordering System
#
# Usage:
#   Local Dev:  Copy to .env and configure local endpoints/credentials.
#   Production: Injected into ECS Task Definition as environment variables.
#               DO NOT put real credentials or secrets into this file or git.
# ==============================================================================

# Application Settings
ENVIRONMENT=
APP_NAME=
APP_VERSION=
DEBUG=

# AWS Configuration
# AWS CLI & ECS Region (default: ap-south-1)
AWS_REGION=

# AWS Credentials (LOCAL DEVELOPMENT ONLY)
# In ECS Production: LEAVE EMPTY. Credentials are provided dynamically
# via the IAM Task Role attached to the ECS container.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Amazon DynamoDB Configuration
DYNAMODB_TABLE_NAME=
# Local mock/DynamoDB Local endpoint (leave empty for AWS Cloud):
DYNAMODB_ENDPOINT_URL=

# Amazon S3 Configuration
S3_BUCKET_NAME=
# Local mock/LocalStack endpoint (leave empty for AWS Cloud):
S3_ENDPOINT_URL=

# Document Upload Limits
MAX_UPLOAD_SIZE_BYTES=

# Business Logic & Pricing (in paise — 100 paise = 1 INR)
PRICE_PER_PAGE_BW=
PRICE_PER_PAGE_COLOR=

# Queue & Token Engine
QUEUE_TOKEN_PREFIX=
